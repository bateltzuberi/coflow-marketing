# deps
/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# Claude Code tooling
.claude/

# Raw notes behind a research report. The finished report in reports/ is
# committed; the per-source scratch notes that produced it are not — they are
# long, duplicated across runs, and superseded the moment the report is written.
/research_notes/

# A report's PDF is generated from its .md — the markdown is the source that
# gets reviewed and diffed, so the binary stays out of the history.
/reports/*.pdf
